# ==============================================================================
# AlgoPulse Environment Variables
# For local development: Copy to .env.local and fill in your Supabase credentials
# For Vercel production: Add these in your Vercel Project Settings -> Environment Variables
# ==============================================================================

# Supabase Project URL (Found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Public Key (Found in Supabase Dashboard -> Project Settings -> API)
# IMPORTANT: Use ONLY the anon/public key. NEVER use the service_role key here!
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
